@article{Tkac2021,
abstract = {The neurochemical information provided by proton magnetic resonance spectroscopy (MRS) or MR spectroscopic imaging (MRSI) can be severely compromised if strong signals originating from brain water and extracranial lipids are not properly suppressed. The authors of this paper present an overview of advanced water/lipid-suppression techniques and describe their advantages and disadvantages. Moreover, they provide recommendations for choosing the most appropriate techniques for proper use. Methods of water signal handling are primarily focused on the VAPOR technique and on MRS without water suppression (metabolite cycling). The section on lipid-suppression methods in MRSI is divided into three parts. First, lipid-suppression techniques that can be implemented on most clinical MR scanners (volume preselection, outer-volume suppression, selective lipid suppression) are described. Second, lipid-suppression techniques utilizing the combination of k-space filtering, high spatial resolutions and lipid regularization are presented. Finally, three promising new lipid-suppression techniques, which require special hardware (a multi-channel transmit system for dynamic B1+ shimming, a dedicated second-order gradient system or an outer volume crusher coil) are introduced.},
author = {Tk{\'{a}}{\v{c}}, Ivan and Deelchand, Dinesh and Dreher, Wolfgang and Hetherington, Hoby and Kreis, Roland and Kumaragamage, Chathura and Pova{\v{z}}an, Michal and Spielman, Daniel M. and Strasser, Bernhard and de Graaf, Robin A.},
doi = {10.1002/nbm.4459},
file = {:home/john/Documents/Research/Literature/Spectroscopy/NBM 2021 Consesus Papers/Water and lipid suppression techniques for advanced 1H MRS and MRSI of the human brain.pdf:pdf},
isbn = {3200301759},
issn = {10991492},
journal = {NMR in Biomedicine},
keywords = {ECLIPSE,L-regularization,VAPOR,crusher coils,dynamic B1 shimming,high spatial resolution,inversion recovery,metabolite cycling},
number = {5},
pages = {1--25},
pmid = {33327042},
title = {{Water and lipid suppression techniques for advanced 1H MRS and MRSI of the human brain: Experts' consensus recommendations}},
volume = {34},
year = {2021}
}
