file = {:home/john/Documents/Research/Literature/Spectroscopy/NBM 2021 Consesus Papers/Diffusion-weighted MR spectroscopy_ Consensus, recommendations, and resources from acquisition to modeling.pdf:pdf},
issn = {15222594},
journal = {Magnetic Resonance in Medicine},
